# The virtual environment is recreated from pyproject.toml
.venv/

# Python bytecode and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Crawl output: the SQLite state store and any page bodies
*.db
*.db-journal
*.db-wal
*.db-shm
pages/
crawl.log

# Build metadata from the editable install
*.egg-info/
