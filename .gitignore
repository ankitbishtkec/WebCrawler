# The virtual environment is recreated from pyproject.toml
.venv/

# Python bytecode and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The coverage data file; the committed report is docs/coverage_report.txt
.coverage
.coverage.*
htmlcov/

# Crawl output: the SQLite state store and any page bodies
*.db
*.db-journal
*.db-wal
*.db-shm
pages/
crawl.log

# Build metadata from the editable install
*.egg-info/
v.log
